# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by: platform/api/db.go, intelligence/etl_to_database.py
#
# Option A — remote database (Neon or any hosted PostgreSQL)
# Set DATABASE_URL and leave the DB_* vars below empty.
# Neon format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Option B — local Docker (docker-compose.yml)
# Leave DATABASE_URL empty and set the vars below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=api_user
DB_PASSWORD=api_password
DB_NAME=rocket_elevators

# ── Go API ────────────────────────────────────────────────────────────────────
# Used by: platform/api/main.go
# Port must be 8080 — 8081 is blocked by the company firewall
PORT=8080

# Signing secret for chat inspection-scheduling confirmations.
# Used by: platform/api/chat.go
# Signs the pending_action that gates a database write (HMAC over the execution
# fields). If unset, the API generates an ephemeral per-process secret — safe, but
# any pending confirmation is invalidated when the API restarts. Set a stable,
# random value here so confirmations survive restarts (e.g. `openssl rand -hex 32`).
CHAT_SIGNING_SECRET=

# ── Flask dashboard ───────────────────────────────────────────────────────────
# Used by: platform/server.py
# Points to the Go API — change only if running the API on a different host/port
GO_API=http://localhost:8080

# OpenRouter — chat LLM provider
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Docker container name ─────────────────────────────────────────────────────
# Used by: intelligence/generate_explanations.py
# Must match the container name shown by `docker ps` for the PostgreSQL service
DB_CTR=rocket-elevators-ops-dashboard-db-1

# ── FastMCP server (platform/mcp/) ────────────────────────────────────────────
# Used by: platform/mcp/server.py, platform/mcp/rag.py
#
# PostgreSQL connection: reuses DATABASE_URL / DB_* vars above — no new vars needed
#
# ChromaDB path — relative to project root when starting the server from the project root.
# Use an absolute path if starting from a different directory.
# Populated by: py -3 intelligence/rag_preprocessing.py
RAG_CHROMADB_PATH=data/chromadb
#
# Port for the Streamable HTTP transport.
# Go API and Claude Code (.mcp.json) both connect to http://localhost:MCP_PORT/mcp
# Must not conflict with Go API (8080) or Flask (5000).
MCP_PORT=8765
#
# TEST-ONLY: bypass the human-approval gate for inspection scheduling.
# When set, schedule_inspection writes on the first call (no confirmation step).
# The server REFUSES to start if this is set while the environment below is
# production/prod. Leave empty in any environment that serves real users.
MCP_SKIP_CONFIRMATION=
#
# Environment name. Used by: platform/mcp/server.py
# Set to "production" (or "prod") in deployed environments — this activates the
# guard that refuses to start with MCP_SKIP_CONFIRMATION set.
APP_ENV=
